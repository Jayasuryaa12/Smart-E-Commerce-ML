# Production Backend Settings (Render)
PORT=5000
CORS_ORIGINS=*
PYTHON_VERSION=3.10.12

# PostgreSQL Database Storage (Render Managed PostgreSQL or local Postgres/SQLite)
# In Render, this is automatically provided by the database service connection string.
# Example: postgresql://ecommerce_admin:SECRET_PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/ecommerce_ml
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_ml

# Secret key required to unlock detailed raw customer session telemetry on /api/predictions/history
ADMIN_API_KEY=your_secure_admin_api_key_here

# Production Frontend Settings (Vercel)
# In development, leave blank to use the Vite dev proxy to http://localhost:5000
# In production on Vercel, set to your Render backend base URL:
VITE_API_URL=https://smart-e-commerce-ml-1.onrender.com
